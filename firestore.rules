rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 4.1: Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Phase 3: Global Primitives & Role Helpers
    // -------------------------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Bootstrapped runtime owner email (strictly gated on email_verified == true)
    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'kingalone2345@gmail.com';
    }

    function isSuperAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'SUPER_ADMIN'
      );
    }

    function hasActiveUserDoc() {
      return isVerifiedUser() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true;
    }

    function isClinicAdminFor(clinicId) {
      return isValidId(clinicId) &&
        hasActiveUserDoc() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'CLINIC_ADMIN' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clinicId == clinicId;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isOptionalString(val, minLen, maxLen) {
      return val == null || (val is string && val.size() >= minLen && val.size() <= maxLen);
    }

    function isOptionalId(val) {
      return val == null || isValidId(val);
    }

    function isOptionalTimestamp(val) {
      return val == null || val is timestamp;
    }

    function isValidDateStr(val) {
      return val is string && val.size() == 10 && val.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function isValidTimeStr(val) {
      return val is string && val.size() == 5 && val.matches('^\\d{2}:\\d{2}$');
    }

    function isValidRole(val) {
      return val in ['PATIENT', 'CLINIC_ADMIN', 'SUPER_ADMIN'];
    }

    function isValidAppointmentStatus(val) {
      return val in ['BOOKED', 'CHECKED_IN', 'IN_PROGRESS', 'COMPLETED', 'CANCELLED', 'NO_SHOW'];
    }

    function isTerminalAppointmentStatus(val) {
      return val in ['COMPLETED', 'CANCELLED'];
    }

    function isValidClinicAdminTransition(fromStatus, toStatus) {
      return (fromStatus == 'BOOKED' && (toStatus == 'CHECKED_IN' || toStatus == 'NO_SHOW')) ||
        (fromStatus == 'CHECKED_IN' && (toStatus == 'IN_PROGRESS' || toStatus == 'NO_SHOW' || toStatus == 'BOOKED')) ||
        (fromStatus == 'IN_PROGRESS' && (toStatus == 'COMPLETED' || toStatus == 'CHECKED_IN')) ||
        (fromStatus == 'NO_SHOW' && toStatus == 'BOOKED');
    }

    // -------------------------------------------------------------------------
    // Phase 4: Standalone Entity Validation Blueprints (Synched w/ firebase-blueprint.json)
    // -------------------------------------------------------------------------
    function isValidAdminRegistry(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'role', 'createdAt']) &&
        isValidId(data.uid) &&
        data.uid == userId &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.role == 'SUPER_ADMIN' &&
        data.createdAt is timestamp;
    }

    function isValidUser(data, userId) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role', 'isActive', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'name', 'email', 'phone', 'role', 'clinicId', 'inviteId', 'isActive', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.uid == userId &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 80 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        (!('phone' in data) || isOptionalString(data.phone, 0, 30)) &&
        isValidRole(data.role) &&
        (!('clinicId' in data) || isOptionalId(data.clinicId)) &&
        (!('inviteId' in data) || isOptionalId(data.inviteId)) &&
        data.isActive is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidClinicInvite(data) {
      return data.keys().hasAll(['name', 'email', 'clinicId', 'isActive', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['name', 'email', 'phone', 'clinicId', 'isActive', 'claimedUid', 'createdAt', 'updatedAt']) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 80 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        (!('phone' in data) || isOptionalString(data.phone, 0, 30)) &&
        isValidId(data.clinicId) &&
        data.isActive is bool &&
        (!('claimedUid' in data) || isOptionalId(data.claimedUid)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidClinic(data) {
      return data.keys().hasAll(['name', 'address', 'city', 'openTime', 'closeTime', 'isActive', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['name', 'address', 'city', 'phone', 'openTime', 'closeTime', 'isActive', 'createdAt', 'updatedAt']) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 120 &&
        data.address is string && data.address.size() >= 3 && data.address.size() <= 200 &&
        data.city is string && data.city.size() >= 2 && data.city.size() <= 80 &&
        (!('phone' in data) || isOptionalString(data.phone, 0, 30)) &&
        isValidTimeStr(data.openTime) &&
        isValidTimeStr(data.closeTime) &&
        data.isActive is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidSpecialty(data) {
      return data.keys().hasAll(['name']) &&
        data.keys().hasOnly(['name']) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 80;
    }

    function isValidDoctor(data) {
      return data.keys().hasAll(['clinicId', 'specialtyId', 'name', 'consultationFee', 'avgConsultMinutes', 'isActive', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['clinicId', 'specialtyId', 'clinicName', 'clinicCity', 'specialtyName', 'name', 'qualifications', 'bio', 'photoUrl', 'consultationFee', 'avgConsultMinutes', 'isActive', 'createdAt', 'updatedAt']) &&
        isValidId(data.clinicId) &&
        isValidId(data.specialtyId) &&
        (!('clinicName' in data) || isOptionalString(data.clinicName, 2, 120)) &&
        (!('clinicCity' in data) || isOptionalString(data.clinicCity, 2, 80)) &&
        (!('specialtyName' in data) || isOptionalString(data.specialtyName, 2, 80)) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
        (!('qualifications' in data) || isOptionalString(data.qualifications, 0, 150)) &&
        (!('bio' in data) || isOptionalString(data.bio, 0, 500)) &&
        (!('photoUrl' in data) || isOptionalString(data.photoUrl, 0, 250000)) &&
        data.consultationFee is int && data.consultationFee >= 0 && data.consultationFee <= 100000 &&
        data.avgConsultMinutes is int && data.avgConsultMinutes >= 5 && data.avgConsultMinutes <= 120 &&
        data.isActive is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidDoctorSchedule(data) {
      return data.keys().hasAll(['doctorId', 'weekday', 'startTime', 'endTime', 'slotMinutes']) &&
        data.keys().hasOnly(['doctorId', 'weekday', 'startTime', 'endTime', 'slotMinutes']) &&
        isValidId(data.doctorId) &&
        data.weekday is int && data.weekday >= 0 && data.weekday <= 6 &&
        isValidTimeStr(data.startTime) &&
        isValidTimeStr(data.endTime) &&
        data.slotMinutes is int && data.slotMinutes >= 5 && data.slotMinutes <= 120;
    }

    function isValidSlotLock(data) {
      return data.keys().hasAll(['doctorId', 'clinicId', 'appointmentId', 'date', 'slotTime', 'tokenNumber', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['doctorId', 'clinicId', 'appointmentId', 'date', 'slotTime', 'tokenNumber', 'status', 'startedAt', 'completedAt', 'createdAt', 'updatedAt']) &&
        isValidId(data.doctorId) &&
        isValidId(data.clinicId) &&
        isValidId(data.appointmentId) &&
        isValidDateStr(data.date) &&
        isValidTimeStr(data.slotTime) &&
        data.tokenNumber is int && data.tokenNumber >= 1 && data.tokenNumber <= 1000 &&
        isValidAppointmentStatus(data.status) &&
        (!('startedAt' in data) || isOptionalTimestamp(data.startedAt)) &&
        (!('completedAt' in data) || isOptionalTimestamp(data.completedAt)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidAppointment(data) {
      return data.keys().hasAll(['patientId', 'patientName', 'doctorId', 'clinicId', 'date', 'slotTime', 'status', 'tokenNumber', 'slotLockId', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['patientId', 'patientName', 'patientPhone', 'doctorId', 'clinicId', 'date', 'slotTime', 'status', 'tokenNumber', 'slotLockId', 'checkedInAt', 'startedAt', 'completedAt', 'cancelledAt', 'createdAt', 'updatedAt']) &&
        isValidId(data.patientId) &&
        data.patientName is string && data.patientName.size() >= 1 && data.patientName.size() <= 80 &&
        (!('patientPhone' in data) || isOptionalString(data.patientPhone, 0, 30)) &&
        isValidId(data.doctorId) &&
        isValidId(data.clinicId) &&
        isValidDateStr(data.date) &&
        isValidTimeStr(data.slotTime) &&
        isValidAppointmentStatus(data.status) &&
        data.tokenNumber is int && data.tokenNumber >= 1 && data.tokenNumber <= 1000 &&
        isValidId(data.slotLockId) &&
        (!('checkedInAt' in data) || isOptionalTimestamp(data.checkedInAt)) &&
        (!('startedAt' in data) || isOptionalTimestamp(data.startedAt)) &&
        (!('completedAt' in data) || isOptionalTimestamp(data.completedAt)) &&
        (!('cancelledAt' in data) || isOptionalTimestamp(data.cancelledAt)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['userId', 'action', 'entity', 'createdAt']) &&
        data.keys().hasOnly(['userId', 'actorEmail', 'actorName', 'action', 'entity', 'entityId', 'createdAt']) &&
        isValidId(data.userId) &&
        (!('actorEmail' in data) || isOptionalString(data.actorEmail, 0, 160)) &&
        (!('actorName' in data) || isOptionalString(data.actorName, 0, 80)) &&
        data.action is string && data.action.size() >= 2 && data.action.size() <= 80 &&
        data.entity is string && data.entity.size() >= 2 && data.entity.size() <= 40 &&
        (!('entityId' in data) || isOptionalString(data.entityId, 0, 128)) &&
        data.createdAt is timestamp &&
        data.createdAt == request.time;
    }

    function isValidClinicInquiry(data) {
      return data.keys().hasAll(['submittedByUid', 'clinicName', 'contactName', 'email', 'phone', 'city', 'referenceId', 'createdAt']) &&
        data.keys().hasOnly(['submittedByUid', 'clinicName', 'contactName', 'email', 'phone', 'city', 'doctorCount', 'message', 'referenceId', 'createdAt']) &&
        isValidId(data.submittedByUid) &&
        data.submittedByUid == request.auth.uid &&
        data.clinicName is string && data.clinicName.size() >= 2 && data.clinicName.size() <= 120 &&
        data.contactName is string && data.contactName.size() >= 2 && data.contactName.size() <= 80 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.phone is string && data.phone.size() >= 6 && data.phone.size() <= 30 &&
        data.city is string && data.city.size() >= 2 && data.city.size() <= 60 &&
        (!('doctorCount' in data) || isOptionalString(data.doctorCount, 0, 30)) &&
        (!('message' in data) || isOptionalString(data.message, 0, 1000)) &&
        data.referenceId is string && data.referenceId.size() >= 3 && data.referenceId.size() <= 30 &&
        data.createdAt is timestamp &&
        data.createdAt == request.time;
    }

    // -------------------------------------------------------------------------
    // Collection Match Blocks (Every blueprint collection + /test/connection)
    // -------------------------------------------------------------------------

    // Connection validation probe (get only, never list or write)
    match /test/{docId} {
      allow get: if docId == 'connection';
      allow list, write: if false;
    }

    // Admin registry
    match /admins/{userId} {
      allow get: if isValidId(userId) && isVerifiedUser() && (request.auth.uid == userId || isSuperAdmin());
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(userId) && isBootstrappedAdmin() &&
        isValidAdminRegistry(incoming(), userId) && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // User profiles (PII protected: Owner or Super Admin only)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isSuperAdmin());
      allow list: if isBootstrappedAdmin() || (isVerifiedUser() && resource.data.uid == request.auth.uid);

      allow create: if isValidId(userId) && isVerifiedUser() && isValidUser(incoming(), userId) &&
        incoming().createdAt == request.time && (
          isSuperAdmin() ||
          (
            isOwner(userId) &&
            incoming().email == request.auth.token.email &&
            incoming().isActive == true && (
              (incoming().role == 'PATIENT' && (!('clinicId' in incoming()) || incoming().clinicId == null)) ||
              (isBootstrappedAdmin() && incoming().role == 'SUPER_ADMIN') ||
              (
                incoming().role == 'CLINIC_ADMIN' &&
                ('inviteId' in incoming()) && isValidId(incoming().inviteId) &&
                exists(/databases/$(database)/documents/clinicInvites/$(incoming().inviteId)) &&
                get(/databases/$(database)/documents/clinicInvites/$(incoming().inviteId)).data.email == request.auth.token.email &&
                get(/databases/$(database)/documents/clinicInvites/$(incoming().inviteId)).data.isActive == true &&
                incoming().clinicId == get(/databases/$(database)/documents/clinicInvites/$(incoming().inviteId)).data.clinicId
              )
            )
          )
        );

      allow update: if isValidId(userId) && isVerifiedUser() && isValidUser(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt && (
          (isSuperAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'role', 'clinicId', 'isActive', 'updatedAt'])) ||
          (
            isOwner(userId) &&
            existing().isActive == true &&
            incoming().role == existing().role &&
            incoming().isActive == existing().isActive &&
            (!('clinicId' in existing()) || incoming().clinicId == existing().clinicId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'updatedAt'])
          )
        );

      allow delete: if false;
    }

    // Clinic admin invites (Super Admin manages, invited user can read/claim own invite)
    match /clinicInvites/{inviteId} {
      allow get: if isValidId(inviteId) && (isSuperAdmin() || (isVerifiedUser() && existing().email == request.auth.token.email));
      allow list: if isBootstrappedAdmin() || (isVerifiedUser() && resource.data.email == request.auth.token.email);

      allow create: if isValidId(inviteId) && isSuperAdmin() && isValidClinicInvite(incoming()) &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/clinics/$(incoming().clinicId));

      allow update: if isValidId(inviteId) && isVerifiedUser() && isValidClinicInvite(incoming()) &&
        incoming().createdAt == existing().createdAt && (
          (isSuperAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'clinicId', 'phone', 'isActive', 'claimedUid', 'updatedAt'])) ||
          (
            existing().email == request.auth.token.email &&
            existing().isActive == true &&
            incoming().claimedUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['claimedUid', 'updatedAt'])
          )
        );

      allow delete: if isValidId(inviteId) && isSuperAdmin();
    }

    // Public catalog: Clinics (Zero PII)
    match /clinics/{clinicId} {
      allow get: if isValidId(clinicId);
      allow list: if true;
      allow create: if isValidId(clinicId) && isSuperAdmin() && isValidClinic(incoming()) && incoming().createdAt == request.time;
      allow update: if isValidId(clinicId) && isSuperAdmin() && isValidClinic(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'address', 'city', 'phone', 'openTime', 'closeTime', 'isActive', 'updatedAt']);
      allow delete: if false;
    }

    // Public catalog: Specialties (Zero PII)
    match /specialties/{specialtyId} {
      allow get: if isValidId(specialtyId);
      allow list: if true;
      allow create: if isValidId(specialtyId) && isSuperAdmin() && isValidSpecialty(incoming());
      allow update: if isValidId(specialtyId) && isSuperAdmin() && isValidSpecialty(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name']);
      allow delete: if false;
    }

    // Public catalog: Doctors (Zero PII)
    match /doctors/{doctorId} {
      allow get: if isValidId(doctorId);
      allow list: if true;
      allow create: if isValidId(doctorId) && isSuperAdmin() && isValidDoctor(incoming()) &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/clinics/$(incoming().clinicId)) &&
        exists(/databases/$(database)/documents/specialties/$(incoming().specialtyId));
      allow update: if isValidId(doctorId) && isSuperAdmin() && isValidDoctor(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        exists(/databases/$(database)/documents/clinics/$(incoming().clinicId)) &&
        exists(/databases/$(database)/documents/specialties/$(incoming().specialtyId)) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['clinicId', 'specialtyId', 'clinicName', 'clinicCity', 'specialtyName', 'name', 'qualifications', 'bio', 'photoUrl', 'consultationFee', 'avgConsultMinutes', 'isActive', 'updatedAt']);
      allow delete: if false;
    }

    // Public catalog: Doctor weekly schedules (Zero PII)
    match /doctorSchedules/{scheduleId} {
      allow get: if isValidId(scheduleId);
      allow list: if true;
      allow create: if isValidId(scheduleId) && isSuperAdmin() && isValidDoctorSchedule(incoming()) &&
        exists(/databases/$(database)/documents/doctors/$(incoming().doctorId));
      allow update: if isValidId(scheduleId) && isSuperAdmin() && isValidDoctorSchedule(incoming()) &&
        incoming().doctorId == existing().doctorId &&
        incoming().diff(existing()).affectedKeys().hasOnly(['weekday', 'startTime', 'endTime', 'slotMinutes']);
      allow delete: if isValidId(scheduleId) && isSuperAdmin();
    }

    // Zero-PII Slot Locks & Live Queue Status (Atomically bound to /appointments)
    match /slotLocks/{slotLockId} {
      allow get: if isValidId(slotLockId);
      allow list: if true;

      allow create: if isValidId(slotLockId) && isVerifiedUser() && isValidSlotLock(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().status == 'BOOKED' &&
        existsAfter(/databases/$(database)/documents/appointments/$(incoming().appointmentId)) &&
        getAfter(/databases/$(database)/documents/appointments/$(incoming().appointmentId)).data.slotLockId == slotLockId &&
        (isSuperAdmin() || getAfter(/databases/$(database)/documents/appointments/$(incoming().appointmentId)).data.patientId == request.auth.uid);

      allow update: if isValidId(slotLockId) && isVerifiedUser() && isValidSlotLock(incoming()) &&
        incoming().doctorId == existing().doctorId &&
        incoming().clinicId == existing().clinicId &&
        incoming().date == existing().date &&
        incoming().slotTime == existing().slotTime && (
          // Re-booking a previously cancelled slot atomically with a new appointment
          (
            existing().status == 'CANCELLED' &&
            incoming().status == 'BOOKED' &&
            existsAfter(/databases/$(database)/documents/appointments/$(incoming().appointmentId)) &&
            getAfter(/databases/$(database)/documents/appointments/$(incoming().appointmentId)).data.slotLockId == slotLockId &&
            getAfter(/databases/$(database)/documents/appointments/$(incoming().appointmentId)).data.patientId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['appointmentId', 'tokenNumber', 'status', 'startedAt', 'completedAt', 'updatedAt'])
          ) ||
          // Cancelling an existing booked slot by its owning patient
          (
            existing().status == 'BOOKED' &&
            incoming().status == 'CANCELLED' &&
            incoming().appointmentId == existing().appointmentId &&
            get(/databases/$(database)/documents/appointments/$(existing().appointmentId)).data.patientId == request.auth.uid &&
            getAfter(/databases/$(database)/documents/appointments/$(existing().appointmentId)).data.status == 'CANCELLED' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          ) ||
          // Clinic admin advancing queue status for their clinic
          (
            isClinicAdminFor(existing().clinicId) &&
            isValidClinicAdminTransition(existing().status, incoming().status) &&
            incoming().appointmentId == existing().appointmentId &&
            getAfter(/databases/$(database)/documents/appointments/$(existing().appointmentId)).data.status == incoming().status &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'startedAt', 'completedAt', 'updatedAt'])
          ) ||
          isSuperAdmin()
        );

      allow delete: if false;
    }

    // Private patient appointments (PII protected & clinic-isolated)
    match /appointments/{appointmentId} {
      allow get: if isValidId(appointmentId) && isVerifiedUser() && (
        existing().patientId == request.auth.uid ||
        isClinicAdminFor(existing().clinicId) ||
        isSuperAdmin()
      );

      allow list: if isVerifiedUser() && (
        resource.data.patientId == request.auth.uid ||
        isBootstrappedAdmin() ||
        isClinicAdminFor(resource.data.clinicId)
      );

      allow create: if isValidId(appointmentId) && isVerifiedUser() && isValidAppointment(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().status == 'BOOKED' &&
        incoming().checkedInAt == null &&
        incoming().startedAt == null &&
        incoming().completedAt == null &&
        incoming().cancelledAt == null &&
        exists(/databases/$(database)/documents/doctors/$(incoming().doctorId)) &&
        get(/databases/$(database)/documents/doctors/$(incoming().doctorId)).data.isActive == true &&
        get(/databases/$(database)/documents/doctors/$(incoming().doctorId)).data.clinicId == incoming().clinicId &&
        existsAfter(/databases/$(database)/documents/slotLocks/$(incoming().slotLockId)) &&
        getAfter(/databases/$(database)/documents/slotLocks/$(incoming().slotLockId)).data.appointmentId == appointmentId &&
        getAfter(/databases/$(database)/documents/slotLocks/$(incoming().slotLockId)).data.status == 'BOOKED' && (
          (incoming().patientId == request.auth.uid && hasActiveUserDoc()) ||
          isSuperAdmin()
        );

      allow update: if isValidId(appointmentId) && isVerifiedUser() && isValidAppointment(incoming()) &&
        incoming().patientId == existing().patientId &&
        incoming().doctorId == existing().doctorId &&
        incoming().clinicId == existing().clinicId &&
        incoming().date == existing().date &&
        incoming().slotTime == existing().slotTime &&
        incoming().tokenNumber == existing().tokenNumber &&
        incoming().slotLockId == existing().slotLockId &&
        incoming().createdAt == existing().createdAt && (
          isSuperAdmin() ||
          (
            existing().patientId == request.auth.uid &&
            existing().status == 'BOOKED' &&
            incoming().status == 'CANCELLED' &&
            getAfter(/databases/$(database)/documents/slotLocks/$(existing().slotLockId)).data.status == 'CANCELLED' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'cancelledAt', 'updatedAt'])
          ) ||
          (
            isClinicAdminFor(existing().clinicId) &&
            !isTerminalAppointmentStatus(existing().status) &&
            isValidClinicAdminTransition(existing().status, incoming().status) &&
            getAfter(/databases/$(database)/documents/slotLocks/$(existing().slotLockId)).data.status == incoming().status &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'checkedInAt', 'startedAt', 'completedAt', 'updatedAt'])
          )
        );

      allow delete: if false;
    }

    // Immutable audit trail (Super Admin reads all; verified actors log own events)
    match /auditLogs/{logId} {
      allow get: if isValidId(logId) && isSuperAdmin();
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(logId) && isVerifiedUser() && isValidAuditLog(incoming()) && (
        isSuperAdmin() || incoming().userId == request.auth.uid
      );
      allow update, delete: if false;
    }

    // Clinic partnership inquiries (Super Admin reads; verified user creates own)
    match /clinicInquiries/{inquiryId} {
      allow get: if isValidId(inquiryId) && isSuperAdmin();
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(inquiryId) && isVerifiedUser() && isValidClinicInquiry(incoming());
      allow update, delete: if false;
    }
  }
}
