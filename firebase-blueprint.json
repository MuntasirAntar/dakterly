{
  "entities": {
    "AdminRegistry": {
      "title": "AdminRegistry",
      "description": "Explicitly authorized platform Super Admin accounts keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the super admin.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified admin email address.",
          "minLength": 3,
          "maxLength": 160
        },
        "role": {
          "type": "string",
          "enum": ["SUPER_ADMIN"],
          "description": "Fixed super admin role."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when admin entry was created."
        }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "Authenticated user profile with PII and RBAC role assignment.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID (or legacy imported account ID).",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Full display name.",
          "minLength": 2,
          "maxLength": 80
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Lowercase email address.",
          "minLength": 3,
          "maxLength": 160
        },
        "phone": {
          "type": "string",
          "description": "Contact phone number.",
          "minLength": 0,
          "maxLength": 30
        },
        "role": {
          "type": "string",
          "enum": ["PATIENT", "CLINIC_ADMIN", "SUPER_ADMIN"],
          "description": "User authorization role."
        },
        "clinicId": {
          "type": "string",
          "description": "Assigned clinic document ID for CLINIC_ADMIN accounts.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "inviteId": {
          "type": "string",
          "description": "Clinic invite document ID used when claiming a CLINIC_ADMIN role.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "isActive": {
          "type": "boolean",
          "description": "Whether the account is active and allowed to sign in."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp."
        }
      },
      "required": ["uid", "name", "email", "role", "isActive", "createdAt", "updatedAt"]
    },
    "ClinicInvite": {
      "title": "ClinicInvite",
      "description": "Super-admin-issued receptionist or clinic manager authorization mapped to an email and clinic.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Receptionist or manager display name.",
          "minLength": 2,
          "maxLength": 80
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Lowercase verified Google/Firebase email allowed to claim this clinic admin role.",
          "minLength": 3,
          "maxLength": 160
        },
        "phone": {
          "type": "string",
          "description": "Staff contact phone.",
          "minLength": 0,
          "maxLength": 30
        },
        "clinicId": {
          "type": "string",
          "description": "Target clinic document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "isActive": {
          "type": "boolean",
          "description": "Whether this clinic admin assignment is active."
        },
        "claimedUid": {
          "type": "string",
          "description": "Firebase Auth UID that claimed this invite.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Update timestamp."
        }
      },
      "required": ["name", "email", "clinicId", "isActive", "createdAt", "updatedAt"]
    },
    "Clinic": {
      "title": "Clinic",
      "description": "Public directory record of a partner medical clinic.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Clinic name.",
          "minLength": 2,
          "maxLength": 120
        },
        "address": {
          "type": "string",
          "description": "Street address.",
          "minLength": 3,
          "maxLength": 200
        },
        "city": {
          "type": "string",
          "description": "City name.",
          "minLength": 2,
          "maxLength": 80
        },
        "phone": {
          "type": "string",
          "description": "Public clinic reception phone.",
          "minLength": 0,
          "maxLength": 30
        },
        "openTime": {
          "type": "string",
          "description": "Opening time in HH:MM 24h format.",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^\\d{2}:\\d{2}$"
        },
        "closeTime": {
          "type": "string",
          "description": "Closing time in HH:MM 24h format.",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^\\d{2}:\\d{2}$"
        },
        "isActive": {
          "type": "boolean",
          "description": "Whether the clinic is visible to patients."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Update timestamp."
        }
      },
      "required": ["name", "address", "city", "openTime", "closeTime", "isActive", "createdAt", "updatedAt"]
    },
    "Specialty": {
      "title": "Specialty",
      "description": "Medical specialty lookup entry.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Specialty name.",
          "minLength": 2,
          "maxLength": 80
        }
      },
      "required": ["name"]
    },
    "Doctor": {
      "title": "Doctor",
      "description": "Public doctor profile linked to a clinic and specialty.",
      "type": "object",
      "properties": {
        "clinicId": {
          "type": "string",
          "description": "Parent clinic document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "specialtyId": {
          "type": "string",
          "description": "Specialty document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "clinicName": {
          "type": "string",
          "description": "Denormalized clinic name.",
          "minLength": 2,
          "maxLength": 120
        },
        "clinicCity": {
          "type": "string",
          "description": "Denormalized clinic city.",
          "minLength": 2,
          "maxLength": 80
        },
        "specialtyName": {
          "type": "string",
          "description": "Denormalized specialty name.",
          "minLength": 2,
          "maxLength": 80
        },
        "name": {
          "type": "string",
          "description": "Doctor full name.",
          "minLength": 2,
          "maxLength": 100
        },
        "qualifications": {
          "type": "string",
          "description": "Academic degrees and certifications.",
          "minLength": 0,
          "maxLength": 150
        },
        "bio": {
          "type": "string",
          "description": "Short biography.",
          "minLength": 0,
          "maxLength": 500
        },
        "photoUrl": {
          "type": "string",
          "description": "HTTPS photo URL or optimized small portrait thumbnail data URL (strictly bounded below 250 KB).",
          "minLength": 0,
          "maxLength": 250000
        },
        "consultationFee": {
          "type": "integer",
          "description": "Consultation fee in BDT."
        },
        "avgConsultMinutes": {
          "type": "integer",
          "description": "Average consultation duration in minutes."
        },
        "isActive": {
          "type": "boolean",
          "description": "Whether doctor accepts bookings."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Update timestamp."
        }
      },
      "required": ["clinicId", "specialtyId", "name", "consultationFee", "avgConsultMinutes", "isActive", "createdAt", "updatedAt"]
    },
    "DoctorSchedule": {
      "title": "DoctorSchedule",
      "description": "Weekly chamber hours for a doctor.",
      "type": "object",
      "properties": {
        "doctorId": {
          "type": "string",
          "description": "Doctor document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "weekday": {
          "type": "integer",
          "description": "Weekday index (0 = Sunday .. 6 = Saturday)."
        },
        "startTime": {
          "type": "string",
          "description": "Chamber start time HH:MM.",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^\\d{2}:\\d{2}$"
        },
        "endTime": {
          "type": "string",
          "description": "Chamber end time HH:MM.",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^\\d{2}:\\d{2}$"
        },
        "slotMinutes": {
          "type": "integer",
          "description": "Duration per appointment slot in minutes."
        }
      },
      "required": ["doctorId", "weekday", "startTime", "endTime", "slotMinutes"]
    },
    "SlotLock": {
      "title": "SlotLock",
      "description": "Zero-PII slot reservation lock and anonymous live queue state for atomic double-booking prevention and live queue counts.",
      "type": "object",
      "properties": {
        "doctorId": {
          "type": "string",
          "description": "Doctor document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "clinicId": {
          "type": "string",
          "description": "Clinic document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "appointmentId": {
          "type": "string",
          "description": "Linked private appointment document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "holderUid": {
          "type": "string",
          "description": "Firebase Auth UID of the patient who booked the slot.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "date": {
          "type": "string",
          "description": "Appointment date YYYY-MM-DD.",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "slotTime": {
          "type": "string",
          "description": "Slot start time HH:MM.",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^\\d{2}:\\d{2}$"
        },
        "tokenNumber": {
          "type": "integer",
          "description": "Sequential token number for the day."
        },
        "status": {
          "type": "string",
          "enum": ["BOOKED", "CHECKED_IN", "IN_PROGRESS", "COMPLETED", "CANCELLED", "NO_SHOW"],
          "description": "Anonymous slot/queue status."
        },
        "startedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when consultation started."
        },
        "completedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when consultation completed."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last status update timestamp."
        }
      },
      "required": ["doctorId", "clinicId", "appointmentId", "holderUid", "date", "slotTime", "tokenNumber", "status", "createdAt", "updatedAt"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Private patient appointment booking and queue lifecycle record scoped to the patient and the clinic.",
      "type": "object",
      "properties": {
        "patientId": {
          "type": "string",
          "description": "Patient Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "patientName": {
          "type": "string",
          "description": "Patient display name shown to the clinic receptionist.",
          "minLength": 1,
          "maxLength": 80
        },
        "patientPhone": {
          "type": "string",
          "description": "Optional patient phone shown to clinic receptionist.",
          "minLength": 0,
          "maxLength": 30
        },
        "doctorId": {
          "type": "string",
          "description": "Booked doctor document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "clinicId": {
          "type": "string",
          "description": "Owning clinic document ID for strict clinic data isolation.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "date": {
          "type": "string",
          "description": "Appointment date YYYY-MM-DD.",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "slotTime": {
          "type": "string",
          "description": "Slot start time HH:MM.",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^\\d{2}:\\d{2}$"
        },
        "status": {
          "type": "string",
          "enum": ["BOOKED", "CHECKED_IN", "IN_PROGRESS", "COMPLETED", "CANCELLED", "NO_SHOW"],
          "description": "Appointment lifecycle state."
        },
        "tokenNumber": {
          "type": "integer",
          "description": "Sequential token number for the doctor and date."
        },
        "slotLockId": {
          "type": "string",
          "description": "Corresponding SlotLock document ID for atomic double-booking guarantee.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "checkedInAt": {
          "type": "string",
          "format": "date-time",
          "description": "Check-in timestamp."
        },
        "startedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Consultation start timestamp."
        },
        "completedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Consultation completion timestamp."
        },
        "cancelledAt": {
          "type": "string",
          "format": "date-time",
          "description": "Cancellation timestamp."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Update timestamp."
        }
      },
      "required": ["patientId", "patientName", "doctorId", "clinicId", "date", "slotTime", "status", "tokenNumber", "slotLockId", "createdAt", "updatedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable administrative activity audit trail.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Actor UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "actorEmail": {
          "type": "string",
          "description": "Actor email at time of event.",
          "minLength": 0,
          "maxLength": 160
        },
        "actorName": {
          "type": "string",
          "description": "Actor name at time of event.",
          "minLength": 0,
          "maxLength": 80
        },
        "action": {
          "type": "string",
          "description": "Audit action code.",
          "minLength": 2,
          "maxLength": 80
        },
        "entity": {
          "type": "string",
          "description": "Target entity name.",
          "minLength": 2,
          "maxLength": 40
        },
        "entityId": {
          "type": "string",
          "description": "Target entity ID or summary.",
          "minLength": 0,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Event timestamp."
        }
      },
      "required": ["userId", "action", "entity", "createdAt"]
    },
    "ClinicInquiry": {
      "title": "ClinicInquiry",
      "description": "Partnership inquiry submitted by a clinic interested in joining Dakterly.",
      "type": "object",
      "properties": {
        "submittedByUid": {
          "type": "string",
          "description": "Verified Firebase Auth UID of the clinic submitter.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "clinicName": {
          "type": "string",
          "description": "Clinic or hospital name.",
          "minLength": 2,
          "maxLength": 120
        },
        "contactName": {
          "type": "string",
          "description": "Contact person name.",
          "minLength": 2,
          "maxLength": 80
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Clinic contact email.",
          "minLength": 3,
          "maxLength": 160
        },
        "phone": {
          "type": "string",
          "description": "Clinic contact phone.",
          "minLength": 6,
          "maxLength": 30
        },
        "city": {
          "type": "string",
          "description": "Clinic city.",
          "minLength": 2,
          "maxLength": 60
        },
        "doctorCount": {
          "type": "string",
          "description": "Estimated number of active doctors.",
          "minLength": 0,
          "maxLength": 30
        },
        "message": {
          "type": "string",
          "description": "Specialties and onboarding notes.",
          "minLength": 0,
          "maxLength": 1000
        },
        "referenceId": {
          "type": "string",
          "description": "Inquiry reference code.",
          "minLength": 3,
          "maxLength": 30
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Submission timestamp."
        }
      },
      "required": ["submittedByUid", "clinicName", "contactName", "email", "phone", "city", "referenceId", "createdAt"]
    }
  },
  "firestore": {
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRegistry" },
      "description": "Super Admin role registry."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles containing PII and role assignment."
    },
    "/clinicInvites/{inviteId}": {
      "schema": { "$ref": "#/entities/ClinicInvite" },
      "description": "Super-admin-managed clinic receptionist authorization invites."
    },
    "/clinics/{clinicId}": {
      "schema": { "$ref": "#/entities/Clinic" },
      "description": "Public directory of active and inactive clinics."
    },
    "/specialties/{specialtyId}": {
      "schema": { "$ref": "#/entities/Specialty" },
      "description": "Public medical specialties catalog."
    },
    "/doctors/{doctorId}": {
      "schema": { "$ref": "#/entities/Doctor" },
      "description": "Public doctor profiles."
    },
    "/doctorSchedules/{scheduleId}": {
      "schema": { "$ref": "#/entities/DoctorSchedule" },
      "description": "Public weekly consultation hours for doctors."
    },
    "/slotLocks/{slotLockId}": {
      "schema": { "$ref": "#/entities/SlotLock" },
      "description": "Zero-PII slot reservation locks and anonymous queue status counters."
    },
    "/appointments/{appointmentId}": {
      "schema": { "$ref": "#/entities/Appointment" },
      "description": "Private patient bookings isolated per patient and per clinic."
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable Super Admin activity audit trail."
    },
    "/clinicInquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/ClinicInquiry" },
      "description": "Partner clinic onboarding inquiries."
    }
  }
}
